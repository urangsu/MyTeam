{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "late-waterfall-c95c",
  "main": "worker.js",
  "compatibility_date": "2026-07-10",
  "preview_urls": false,
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  },
  "ratelimits": [
    {
      "name": "PUBLIC_LOOKUP_RATE_LIMITER",
      "namespace_id": "41003001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ]
}
